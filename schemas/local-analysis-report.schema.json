{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/new-kuwait-/schemas/local-analysis-report.schema.json",
  "title": "Local analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "analysis_id", "decision_at", "capture_mode", "security", "request_sha256", "verified_evidence", "price_session_count", "event_count", "signals", "liquidity", "event_features", "feature_validation", "claim_boundaries", "report_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"}, "status": {"const": "PASS_RESEARCH_SUMMARY"},
    "analysis_id": {"type": "string"}, "decision_at": {"type": "string", "format": "date-time"},
    "capture_mode": {"enum": ["PROSPECTIVE", "HISTORICAL_POINT_IN_TIME"]},
    "security": {"type": "object"}, "request_sha256": {"$ref": "#/$defs/sha256"},
    "verified_evidence": {"type": "array", "minItems": 1}, "price_session_count": {"type": "integer", "minimum": 5},
    "event_count": {"type": "integer", "minimum": 0}, "signals": {"type": "array", "minItems": 4},
    "liquidity": {"type": "object"}, "event_features": {"type": "array", "minItems": 1},
    "feature_validation": {"type": "object"},
    "claim_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["live_collection", "probability", "recommendation", "ranking", "trade_execution", "output_class"],
      "properties": {
        "live_collection": {"const": false}, "probability": {"const": false}, "recommendation": {"const": false},
        "ranking": {"const": false}, "trade_execution": {"const": false},
        "output_class": {"const": "DESCRIPTIVE_RESEARCH_SUMMARY_ONLY"}
      }
    },
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
