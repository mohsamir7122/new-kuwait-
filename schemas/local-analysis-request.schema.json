{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/new-kuwait-/schemas/local-analysis-request.schema.json",
  "title": "Local analysis request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "decision_at", "capture_mode", "identity", "evidence", "prices", "events", "fundamentals", "sentiment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "decision_at": {"type": "string", "format": "date-time"},
    "capture_mode": {"enum": ["PROSPECTIVE", "HISTORICAL_POINT_IN_TIME"]},
    "identity": {"$ref": "#/$defs/identity"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
    "prices": {"type": "array", "minItems": 5, "maxItems": 512, "items": {"$ref": "#/$defs/price"}},
    "events": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/event"}},
    "fundamentals": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fundamentals"}]},
    "sentiment": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/sentiment"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["security_code", "ticker", "isin", "name_ar", "name_en", "board", "market_segment", "currency", "valid_from", "valid_to", "listing_status", "evidence_sha256"],
      "properties": {
        "security_code": {"type": "string", "minLength": 1, "maxLength": 32},
        "ticker": {"type": "string", "minLength": 1, "maxLength": 32},
        "isin": {"type": ["string", "null"]}, "name_ar": {"type": "string"}, "name_en": {"type": "string"},
        "board": {"type": "string", "minLength": 1}, "market_segment": {"type": "string", "minLength": 1},
        "currency": {"const": "KWD"}, "valid_from": {"type": "string", "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"},
        "listing_status": {"enum": ["ACTIVE", "LISTED", "TRADING", "SUSPENDED", "HALTED"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "price": {
      "type": "object", "additionalProperties": false, "required": ["date", "close_fils", "volume", "turnover_kwd", "evidence_sha256"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "close_fils": {"type": "number", "exclusiveMinimum": 0},
        "volume": {"type": ["number", "null"], "minimum": 0}, "turnover_kwd": {"type": ["number", "null"], "minimum": 0},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "security_code", "source_id", "source_role", "event_type", "direction", "novelty", "event_at", "published_at", "first_available_at", "captured_at", "content_hash", "evidence_hash", "relation_type", "original_event_id", "raw_text"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "security_code": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1}, "source_role": {"type": "string"}, "event_type": {"type": "string"},
        "direction": {"type": "string"}, "novelty": {"type": "number", "minimum": 0, "maximum": 1},
        "event_at": {"type": "string", "format": "date-time"}, "published_at": {"type": "string", "format": "date-time"},
        "first_available_at": {"type": "string", "format": "date-time"}, "captured_at": {"type": "string", "format": "date-time"},
        "content_hash": {"$ref": "#/$defs/sha256"}, "evidence_hash": {"$ref": "#/$defs/sha256"},
        "relation_type": {"type": "string"}, "original_event_id": {"type": ["string", "null"]}, "raw_text": {"type": "string"}
      }
    },
    "financials": {
      "type": "object", "additionalProperties": false, "required": ["revenue", "net_income", "operating_cash_flow", "total_debt", "equity"],
      "properties": {"revenue": {"type": "number"}, "net_income": {"type": "number"}, "operating_cash_flow": {"type": "number"}, "total_debt": {"type": "number"}, "equity": {"type": "number"}}
    },
    "fundamentals": {
      "type": "object", "additionalProperties": false, "required": ["current", "prior", "evidence_sha256s"],
      "properties": {"current": {"$ref": "#/$defs/financials"}, "prior": {"$ref": "#/$defs/financials"}, "evidence_sha256s": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}}}
    },
    "sentiment": {
      "type": "object", "additionalProperties": false, "required": ["origin_id", "author_id", "tone", "author_reliability", "evidence_sha256"],
      "properties": {"origin_id": {"type": "string", "minLength": 1}, "author_id": {"type": "string", "minLength": 1}, "tone": {"type": "number", "minimum": -1, "maximum": 1}, "author_reliability": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
